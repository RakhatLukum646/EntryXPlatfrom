# Доступы администратора Dify и Twenty для этой установки (только localhost).
# install.ps1 / install.sh копируют файл в .secrets/local-accounts.env и сами придумывают пароль Dify, если он пустой.
DIFY_URL=http://localhost
DIFY_EMAIL=admin@entryx.local
DIFY_NAME=Entryx Admin
DIFY_PASSWORD=

# Twenty: аккаунт создаётся в браузере на первом запуске (http://localhost:3000). Запишите сюда, чтобы не забыть.
TWENTY_URL=http://localhost:3000
TWENTY_EMAIL=
TWENTY_PASSWORD=
