# Секреты и локальные настройки: создаются install.ps1 / install.sh, в git не попадают
.env
*.env
!*.env.example
.secrets/

# Python
.venv/
__pycache__/

# Данные моста
bridge/docker-compose.override.yml
bridge/bridge.db
bridge/bridge.log
bridge/data/*
!bridge/data/.gitkeep

# Данные Dify (базы, файлы, плагины) — создаются при запуске
dify/volumes/app/
dify/volumes/db/
dify/volumes/redis/
dify/volumes/weaviate/
dify/volumes/plugin_daemon/
dify/volumes/certbot/
dify/volumes/sandbox/dependencies/

# Ссылки на опубликованные страницы агентов — свои у каждой установки
artifacts/urls.json
