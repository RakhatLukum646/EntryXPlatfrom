# Twenty CRM: Settings → APIs & Webhooks → Create API key
TWENTY_URL=http://localhost:3000
TWENTY_API_KEY=

# Кому назначать задачи, пока у ролей нет своих пользователей (id участника рабочего пространства).
# Мост сам подставит первого участника, если пусто. Для отдельного человека: TWENTY_MEMBER_YULIA=<id>
TWENTY_DEFAULT_MEMBER_ID=

# Dify: у каждого импортированного агента → API Access → API Key.
# Нет ключа — задача создаётся по шаблону из process/stages.yaml (ручная версия).
DIFY_API=http://localhost/v1
DIFY_KEY_ZAKUPKA=
DIFY_KEY_MANAGER=
DIFY_KEY_LOGISTIKA=
DIFY_KEY_FINANCE=
DIFY_KEY_PRIEMKA=
DIFY_KEY_MONTAZH=
DIFY_KEY_RUKOVODITEL=

POLL_SECONDS=10
